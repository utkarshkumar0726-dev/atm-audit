PORT=5000

# MySQL Database configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=atm_audit
# Optional connection string (e.g. for cloud MySQL like PlanetScale / Aiven / TiDB)
# MYSQL_URI=mysql://user:password@host:port/atm_audit

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# Used only by scripts/seedAdmin.js to create the first admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Administrator
